{
    "name": "EvenFall Calm-Lavinder",
    "colors": {
      "editor.background": "#1E1E1E",
      "editor.foreground": "#E8E8E8",
      "editorLineNumber.foreground": "#A6A6A6",
      "editorCursor.foreground": "#C792EA",
      "editor.lineHighlightBackground": "#2C2C2C",
      "editor.selectionBackground": "#3A3A3A",
      "activityBar.background": "#202020",
      "activityBar.foreground": "#B5A7F6",
      "activityBarBadge.background": "#B5A7F6",
      "activityBarBadge.foreground": "#000000",
      "sideBar.background": "#121212",
      "sideBar.foreground": "#B5B5B5",
      "sideBarTitle.foreground": "#B5A7F6",
      "sideBarSectionHeader.background": "#1C1C1C",
      "statusBar.background": "#1C1C1C",
      "statusBar.foreground": "#B5A7F6",
      "statusBar.border": "#C792EA",
      "tab.activeBackground": "#1E1E1E",
      "tab.activeForeground": "#FFFFFF",
      "tab.inactiveBackground": "#121212",
      "tab.inactiveForeground": "#AAAAAA",
      "tab.border": "#1E1E1E",
      "scrollbarSlider.background": "#444444",
      "scrollbarSlider.hoverBackground": "#666666",
      "terminal.background": "#1E1E1E",
      "terminal.foreground": "#CCCCCC",
      "terminalCursor.foreground": "#C792EA",
      "button.background": "#C792EA",
      "button.foreground": "#FFFFFF",
      "button.hoverBackground": "#B583EA"
    },
    "tokenColors": [
      {
        "name": "Comment",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#546E7A"
        }
      },
      {
        "name": "Keyword",
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": {
          "foreground": "#C792EA"
        }
      },
      {
        "name": "String",
        "scope": ["string", "constant.other.symbol"],
        "settings": {
          "foreground": "#C3E88D"
        }
      },
      {
        "name": "Function",
        "scope": ["entity.name.function", "support.function"],
        "settings": {
          "foreground": "#B5A7F6"
        }
      },
      {
        "name": "Variable",
        "scope": ["variable", "string constant.other.placeholder"],
        "settings": {
          "foreground": "#EEFFFF"
        }
      },
      {
        "name": "Number",
        "scope": ["constant.numeric", "constant.language"],
        "settings": {
          "foreground": "#F78C6C"
        }
      },
      {
        "name": "Tag",
        "scope": ["entity.name.tag"],
        "settings": {
          "foreground": "#FF5370"
        }
      },
      {
        "name": "Attribute",
        "scope": ["entity.other.attribute-name"],
        "settings": {
          "foreground": "#C792EA"
        }
      },
      {
        "name": "Class",
        "scope": ["entity.name.class", "support.class"],
        "settings": {
          "foreground": "#FFCB6B"
        }
      },
      {
        "name": "Operator",
        "scope": [
          "keyword.control",
          "constant.other.color",
          "punctuation",
          "meta.tag"
        ],
        "settings": {
          "foreground": "#FFA500"
        }
      }
    ]
  }
  